#:kivy 2.0.0
#:import random random

<TetrisGame>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        Label:
            text: '俄罗斯方块'
            font_name: 'simsun.ttc'
            font_size: 36
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 60

        BoxLayout:
            orientation: 'horizontal'
            spacing: 20

            # 游戏区域
            GridLayout:
                cols: 1
                size_hint_x: 0.7
                spacing: 5

                CanvasWidget:
                    id: game_canvas

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 50
                    spacing: 10

                    Button:
                        text: '左移'
                        font_name: 'simsun.ttc'
                        font_size: 20
                        on_press: root.move_left()

                    Button:
                        text: '旋转'
                        font_name: 'simsun.ttc'
                        font_size: 20
                        on_press: root.rotate_block()

                    Button:
                        text: '右移'
                        font_name: 'simsun.ttc'
                        font_size: 20
                        on_press: root.move_right()

                    Button:
                        text: '加速下落'
                        font_name: 'simsun.ttc'
                        font_size: 20
                        on_press: root.fast_drop()

            # 信息面板
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.3
                spacing: 20

                Label:
                    text: '分数: 0'
                    id: score_label
                    font_name: 'simsun.ttc'
                    font_size: 24
                    color: 1, 1, 1, 1

                Label:
                    text: '等级: 1'
                    id: level_label
                    font_name: 'simsun.ttc'
                    font_size: 24
                    color: 1, 1, 1, 1

                Label:
                    text: '下一个:'
                    font_name: 'simsun.ttc'
                    font_size: 20
                    color: 1, 1, 1, 1

                Widget:
                    id: next_block_canvas
                    size_hint_y: None
                    height: 100

                Button:
                    text: '开始/暂停'
                    font_name: 'simsun.ttc'
                    font_size: 24
                    on_press: root.toggle_pause()

                Button:
                    text: '重新开始'
                    font_name: 'simsun.ttc'
                    font_size: 24
                    on_press: root.restart_game()

<CanvasWidget>:
    canvas:
        Color:
            rgba: 0.2, 0.2, 0.2, 1
        Rectangle:
            pos: self.pos
            size: self.size